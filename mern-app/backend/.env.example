# .env.example - copy this file to .env and edit it:
#     cp .env.example .env
# Real environment variables (e.g. from Docker) take priority over this file.

# Port the Express server listens on.
PORT=4000

# MongoDB connection string. The last part ("mern_tasks") is the database name.
# Local MongoDB (or `docker compose up -d mongo`):
MONGODB_URI=mongodb://127.0.0.1:27017/mern_tasks
# MongoDB Atlas (free cloud database) looks like this instead:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mern_tasks

# Browser origins allowed to call the API directly (comma-separated).
# Not needed when the UI goes through the Vite proxy or nginx, but useful if you
# host the frontend on another domain.
CLIENT_ORIGIN=http://localhost:5173
