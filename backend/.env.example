# ---------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and fill in your values:
#     cp .env.example .env
# Every setting here is optional EXCEPT the Anthropic API key.
# App settings start with KNOWRAG_ so they never clash with other tools' variables.
# ---------------------------------------------------------------------------

# Your Claude API key from https://console.anthropic.com/ (keep it secret, never commit it).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model writes the answers. Claude Opus 5.5 is the default.
KNOWRAG_CLAUDE_MODEL=claude-opus-5-5
# How hard Claude thinks before answering: low | medium | high | xhigh | max.
# "low" is fastest/cheapest, "medium" is a good balance for document Q&A.
KNOWRAG_CLAUDE_EFFORT=medium
# Upper limit on the number of tokens Claude may generate per answer.
KNOWRAG_CLAUDE_MAX_TOKENS=64000
# If Claude's safety classifiers decline a request, retry it on Anthropic's
# recommended fallback model automatically (Claude API only).
KNOWRAG_CLAUDE_REFUSAL_FALLBACK=true
# Rewrite follow-up questions ("what about the second one?") into standalone
# search queries before retrieval. Costs one extra small Claude call per follow-up.
KNOWRAG_QUERY_REWRITE=true

# Embedding provider: "fastembed" (semantic, local, downloads ~70 MB once)
# or "hash" (offline keyword-style vectors, no download - good for demos/tests).
KNOWRAG_EMBEDDING_PROVIDER=fastembed
# Which FastEmbed model to use (only used when KNOWRAG_EMBEDDING_PROVIDER=fastembed).
KNOWRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking: max characters per chunk, and how many characters neighbouring chunks share.
KNOWRAG_CHUNK_SIZE=1000
KNOWRAG_CHUNK_OVERLAP=200
# How many chunks to retrieve and show Claude for every question.
KNOWRAG_TOP_K=5

# Where the SQLite database (documents, chunks, vectors) is stored.
KNOWRAG_DATA_DIR=./data
# Largest file (in megabytes) that may be uploaded.
KNOWRAG_MAX_UPLOAD_MB=20
# Comma-separated list of browser origins allowed to call the API (the React dev server).
KNOWRAG_CORS_ORIGINS=http://localhost:5173
